+/// The step `totp_token` matches in `totp_uri`, and how long that step can still be accepted, in seconds; `None` when
+/// it matches none. A step is accepted until the step after it ends (an otpauth URL always has a skew of 1).
+pub fn verify_totp_code(totp_uri: &str, totp_token: &str) -> trc::Result<Option<(u64, u64)>> {
+    let totp = Totp::from_url(totp_uri).map_err(|err| {
+        trc::AuthEvent::Error
+            .reason(err)
+            .details(totp_uri.to_string())
+    })?;
+    let period = totp.next_step(0);
+    Ok(totp.check_current(totp_token).map(|step| {
+        (step, ((step + 2) * period).saturating_sub(store::write::now()) + 1)
+    }))
+}
