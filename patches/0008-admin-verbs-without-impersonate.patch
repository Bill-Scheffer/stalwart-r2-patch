+impl Server {
+    /// MainThrive patch 0008: whether `access_token` may run one of the admin verbs on
+    /// `account_id` (Sieve, out-of-office, identities, issuing an app password) without being
+    /// one of its owners. Upstream allows only owners or `impersonate`, and `impersonate` also
+    /// reads all mail. This needs `sysAccountUpdate`, the account inside the caller's tenant
+    /// (any tenant for an untenanted caller), and the grant rule on the account as stored, so
+    /// it never reaches an Admin or any account holding a permission the caller lacks.
+    pub async fn can_administer_account(
+        &self,
+        access_token: &AccessToken,
+        account_id: u32,
+    ) -> trc::Result<bool> {
+        if !access_token.has_permission(Permission::SysAccountUpdate) {
+            return Ok(false);
+        }
+        let Some(account) = self
+            .registry()
+            .object::<Account>(account_id.into())
+            .await
+            .caused_by(trc::location!())?
+        else {
+            return Ok(false);
+        };
+        let tenant_id = match &account {
+            Account::User(account) => account.member_tenant_id,
+            Account::Group(account) => account.member_tenant_id,
+        };
+        if access_token
+            .tenant_id()
+            .is_some_and(|caller_tenant_id| tenant_id != Some(Id::from(caller_tenant_id)))
+        {
+            return Ok(false);
+        }
+
+        Ok(self
+            .can_set_permissions(access_token, &account)
+            .await?
+            .is_ok())
+    }
+}
