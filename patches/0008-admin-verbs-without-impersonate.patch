+/// MainThrive patch 0008: `assert_is_member`, or an admin verb's caller that
+/// `Server::can_administer_account` admits. Used only by the methods MainThrive lists, none of
+/// which reads mail: Identity, SieveScript, VacationResponse, and issuing an app password.
+async fn assert_can_administer(
+    server: &Server,
+    access_token: &AccessToken,
+    account_id: Id,
+) -> trc::Result<()> {
+    if access_token.is_member(account_id.document_id())
+        || server
+            .can_administer_account(access_token, account_id.document_id())
+            .await?
+    {
+        Ok(())
+    } else {
+        access_token.assert_is_member(account_id).map(|_| ())
+    }
+}
