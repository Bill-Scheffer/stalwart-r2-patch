+/// MainThrive patch 0007: a caller may update or destroy an account only if it could have
+/// created it, i.e. it holds every permission the account has now (Stalwart's own grant rule,
+/// applied to the target as stored). Without it, `sysAccountUpdate` reaches every account:
+/// a narrow key could reset an Admin's password, or its own owner's, and take it over.
+pub(crate) async fn validate_account_target(
+    server: &Server,
+    access_token: &AccessToken,
+    account: &Account,
+) -> trc::Result<Result<(), SetError<Property>>> {
+    Ok(server
+        .can_set_permissions(access_token, account)
+        .await?
+        .map_err(|_| {
+            SetError::forbidden().with_description("This account's permissions exceed yours.")
+        }))
+}
