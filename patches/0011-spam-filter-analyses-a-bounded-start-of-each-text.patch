+// Every word and every space of a text part becomes a 224-byte token, held until the message is scored, so the
+// filter costs about 40 times the text it analyses: 400 MiB for a 10 MiB text/plain message, which no size limit
+// sees. Like other filters (SpamAssassin skips bodies past 500 KB), analyse only the start of each part's text, plain
+// or extracted from HTML, so both alternatives of a message are cut at about the same point, and only so much per
+// message. HTML markup costs 5 to 24 times itself to parse (measured), so it is read up to its own limit. A message
+// then costs at most ~90 MiB to analyse, whatever it holds.
+const MAX_ANALYSED_PART: usize = 512 * 1024;
+const MAX_ANALYSED_MESSAGE: usize = 1024 * 1024;
+const MAX_READ_HTML: usize = 2 * 1024 * 1024;
+
+/// The start of `text`, at most `max` bytes, cut on a character boundary and taken from what the message has left.
+fn analysed<'x>(text: &'x str, max: usize, left: &mut usize) -> &'x str {
+    let end = text.floor_char_boundary(max.min(*left));
+    *left -= end;
+    &text[..end]
+}
+
+/// The HTML that is read, up to what the message has left of `MAX_READ_HTML`, and whether any was left out. A data:
+/// URI's payload is not markup and is left out (its header, which the analysis reads, is kept): a large inline image
+/// would otherwise use up the budget before any of the text.
+fn readable_html<'x>(html: &'x str, left: &mut usize) -> (Cow<'x, str>, bool) {
+    if !html.contains("data:") {
+        let read = analysed(html, usize::MAX, left);
+        return (read.into(), read.len() < html.len());
+    }
+    let mut read = String::new();
+    let mut rest = html;
+    while let Some(at) = rest.find("data:").filter(|&at| read.len() + at < *left) {
+        let head = &rest.as_bytes()[at..rest.len().min(at + 100)];
+        let header = head
+            .windows(8)
+            .position(|w| w == b";base64,")
+            .filter(|&i| !head[..i].iter().any(|b| b"\"' <>".contains(b)));
+        let keep = at + header.map_or(5, |i| i + 8);
+        read.push_str(&rest[..keep]);
+        rest = &rest[keep..];
+        if header.is_some() {
+            rest = rest
+                .trim_start_matches(|c: char| c.is_ascii_alphanumeric() || "+/=\r\n".contains(c));
+        }
+    }
