+
+/// MainThrive patch 0011: the HTML that is analysed, with the payload of a data: URI in a `src` or `href` left out
+/// (its header, which the analysis reads, is kept). A large inline image is not markup: counted, it uses up the part's
+/// text budget before any of the text and scores the message as all image (HTML_TEXT_IMG_RATIO), which 0.16 with this
+/// patch did not (MainThrive MAI-1077, MAI-1441). Anywhere else, in text or another attribute, it is read as written,
+/// so it cannot hide words.
+fn without_data_payloads(html: Cow<'_, str>) -> Cow<'_, str> {
+    if !html.contains("data:") {
+        return html;
+    }
+    let mut read = String::with_capacity(html.len().min(1024 * 1024));
+    let mut rest: &str = &html;
+    while let Some(at) = rest.find("data:") {
+        let before = html.as_bytes()[..html.len() - rest.len() + at].trim_ascii_end();
+        let before = before
+            .strip_suffix(b"\"")
+            .or_else(|| before.strip_suffix(b"'"))
+            .unwrap_or(before)
+            .trim_ascii_end();
+        let in_src_or_href = before.strip_suffix(b"=").is_some_and(|name| {
+            let name = name.trim_ascii_end();
+            [b"src".as_slice(), b"href"].iter().any(|attr| {
+                name.len() > attr.len()
+                    && name[name.len() - attr.len()..].eq_ignore_ascii_case(attr)
+                    && name[name.len() - attr.len() - 1].is_ascii_whitespace()
+            })
+        });
+        let head = &rest.as_bytes()[at..rest.len().min(at + 100)];
+        let header = head
+            .windows(8)
+            .position(|w| w == b";base64,")
+            .filter(|&i| in_src_or_href && !head[..i].iter().any(|b| b"\"' <>".contains(b)));
+        let keep = at + header.map_or(5, |i| i + 8);
+        read.push_str(&rest[..keep]);
+        rest = &rest[keep..];
+        if header.is_some() {
+            rest = rest
+                .trim_start_matches(|c: char| c.is_ascii_alphanumeric() || "+/=\r\n".contains(c));
+        }
+    }
+    read.push_str(rest);
+    Cow::Owned(read)
+}
