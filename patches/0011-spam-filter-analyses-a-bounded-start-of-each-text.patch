+// Every word and every space of a text part becomes a 224-byte token, held until the message is scored, so the
+// filter costs about 40 times the text it analyses: 400 MiB for a 10 MiB text/plain message, which no size limit
+// sees. Like other filters (SpamAssassin skips bodies past 500 KB), analyse only the start of each text or HTML
+// part, and only so much per message, so that cost is bounded whatever the message holds: at most ~40 MiB.
+const MAX_ANALYSED_PART: usize = 512 * 1024;
+const MAX_ANALYSED_MESSAGE: usize = 1024 * 1024;
+
+/// The start of `text` that is analysed, cut on a character boundary, taken from what the message has left.
+fn analysed<'x>(text: &'x str, left: &mut usize) -> &'x str {
+    let mut end = text.len().min(MAX_ANALYSED_PART).min(*left);
+    while !text.is_char_boundary(end) {
+        end -= 1;
+    }
+    *left -= end;
+    &text[..end]
+}
