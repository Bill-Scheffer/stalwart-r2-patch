+// Every word and every space of a text part becomes a 224-byte token, held until the message is scored, so the
+// filter costs about 40 times the text it analyses: 400 MiB for a 10 MiB text/plain message, which no size limit
+// sees. Like other filters (SpamAssassin skips bodies past 500 KB), analyse only the start of each part's text, plain
+// or extracted from HTML, so both alternatives of a message are cut at the same point, and only so much per message.
+// HTML markup costs ~5 times itself to parse, so it is read up to its own, larger limit. A message then costs at most
+// ~65 MiB to analyse, whatever it holds.
+const MAX_ANALYSED_PART: usize = 512 * 1024;
+const MAX_ANALYSED_MESSAGE: usize = 1024 * 1024;
+const MAX_READ_HTML: usize = 4 * 1024 * 1024;
+
+/// The start of `text`, at most `max` bytes, cut on a character boundary and taken from what the message has left.
+fn analysed<'x>(text: &'x str, max: usize, left: &mut usize) -> &'x str {
+    let end = text.floor_char_boundary(max.min(*left));
+    *left -= end;
+    &text[..end]
+}
+
+/// A cut HTML part has lost its closing tags, which would score as unbalanced HTML: close the head and body it left
+/// open, counted as the HTML analysis counts them.
+fn close_cut_html(tokens: &mut Vec<HtmlToken>) {
+    for tag in [BODY, HEAD] {
+        let open = tokens.iter().fold(0i32, |open, token| match token {
+            HtmlToken::StartTag {
+                name,
+                is_self_closing: false,
+                ..
+            } if *name == tag => open + 1,
+            HtmlToken::EndTag { name } if *name == tag => open - 1,
+            _ => open,
+        });
+        for _ in 0..open {
+            tokens.push(HtmlToken::EndTag { name: tag });
+        }
+    }
+}
