+/// The lookup namespace holding one row per account that opted in to screening: the key is the
+/// account's id, and the row's presence is the opt-in. No row, no action on any verdict.
+const SPAM_SCREEN_NAMESPACE: &str = "spam-screen";
+
+/// The header the screening hook writes, topmost: `v=1; verdict=junk` or `v=1; verdict=pass`.
+const SCREEN_HEADER: &str = "X-MainThrive-Screen";
+
+/// Whether the account opted in to screening. Never an error, for the reason `spam_level` gives:
+/// a lookup that fails reads as not opted in, and is logged.
+async fn spam_screen_opted_in(
+    server: &Server,
+    account_id: u32,
+    address: &str,
+    session_id: u64,
+) -> bool {
+    // No store under the namespace is no row, as for `spam_level`.
+    let Some(store) = server.get_lookup_store(SPAM_SCREEN_NAMESPACE) else {
+        return false;
+    };
+    match store.key_exists(Id::from(account_id).to_string()).await {
+        Ok(opted_in) => opted_in,
+        Err(err) => {
+            trc::error!(
+                err.details("Spam screening lookup failed, delivering as not opted in.")
+                    .ctx(trc::Key::To, address.to_string())
+                    .span_id(session_id)
+                    .caused_by(trc::location!())
+            );
+            false
+        }
+    }
+}
+
+/// Whether the topmost screening header is exactly a junk verdict. Only the topmost: the hook
+/// inserts its own there, so any copy below is the sender's. Anything else reads as no verdict: a
+/// verdict can only move mail into Junk, so what cannot be read leaves Stalwart's decision alone.
+fn top_screen_verdict_is_junk(raw_message: &[u8]) -> bool {
+    // Not `header_raw()`: it searches from the last header, and that copy is the sender's.
+    MessageParser::new()
+        .parse_headers(raw_message)
+        .is_some_and(|message| {
+            message
+                .headers()
+                .iter()
+                .find(|header| header.name.as_str().eq_ignore_ascii_case(SCREEN_HEADER))
+                .and_then(|header| {
+                    raw_message.get(header.offset_start as usize..header.offset_end as usize)
+                })
+                .is_some_and(screen_value_is_junk)
+        })
+}
+
+fn screen_value_is_junk(value: &[u8]) -> bool {
+    std::str::from_utf8(value).is_ok_and(|value| {
+        let mut tags = value.split(';').map(str::trim);
+        tags.next() == Some("v=1") && tags.next() == Some("verdict=junk") && tags.next().is_none()
+    })
+}
