+fn header_pairs(message: &AuthenticatedMessage<'_>) -> Vec<(String, String)> {
+    message
+        .raw_parsed_headers()
+        .iter()
+        .map(|(k, v)| {
+            (
+                String::from_utf8_lossy(k).into_owned(),
+                String::from_utf8_lossy(v).into_owned(),
+            )
+        })
+        .collect()
+}
