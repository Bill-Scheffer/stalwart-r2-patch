+        {
+            let reason = match refusal {
+                common::file_scan::FileRefusal::Infected => "The message contains malware.",
+                common::file_scan::FileRefusal::Unscanned => {
+                    "The message could not be scanned for malware; try again later."
+                }
+            };
+            // No numeric Code: IMAP reads the FIRST Code key, and APPEND sets CANNOT on this error.
+            return Err(trc::EventType::MessageIngest(trc::MessageIngestEvent::Error)
+                .ctx(trc::Key::Reason, reason)
+                .details(reason));
+        }
+
         // Parse message
