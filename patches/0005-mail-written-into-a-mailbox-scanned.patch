         })?;
 
+        // MainThrive patch 0005: antivirus (common::file_scan). Mail written straight into a mailbox (JMAP
+        // Email/import, a JMAP draft, IMAP APPEND) never passes the SMTP milter, so it is scanned here and refused if
+        // infected or if it could not be scanned (fail closed). Every source is named, so a new one must decide: SMTP
+        // mail was scanned by the milter; Restore re-stores our own backups.
+        let scan = match params.source {
+            IngestSource::Jmap { .. } | IngestSource::Imap { .. } => true,
+            IngestSource::Smtp { .. } | IngestSource::Restore => false,
+        };
+        if scan && let Err(refusal) = common::file_scan::scan_file(account_id, params.raw_message).await
+        {
+            let reason = match refusal {
+                common::file_scan::FileRefusal::Infected => "The message contains malware.",
+                common::file_scan::FileRefusal::Unscanned => {
+                    "The message could not be scanned for malware; try again later."
+                }
+            };
+            // No numeric Code: IMAP reads the FIRST Code key, and APPEND sets CANNOT on this error.
+            return Err(trc::EventType::MessageIngest(trc::MessageIngestEvent::Error)
+                .ctx(trc::Key::Reason, reason)
+                .details(reason));
+        }
+
         // Obtain message references and thread name
