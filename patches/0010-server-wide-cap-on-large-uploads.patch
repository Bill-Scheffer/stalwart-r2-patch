+/// A request body past this size is a large one: it counts against `STALWART_MAX_LARGE_UPLOADS`.
+const LARGE_BODY: usize = 1024 * 1024;
+
+/// Large bodies held in memory right now, on this server.
+static LARGE_IN_FLIGHT: AtomicUsize = AtomicUsize::new(0);
+
+/// How many large bodies the whole server may hold at once (`STALWART_MAX_LARGE_UPLOADS`). Unset, there is
+/// no bound (upstream's behaviour). Each account is bounded already; this bounds the sum, so a burst across
+/// accounts is refused, retryably, before it can take the process past its memory limit.
+fn max_large_bodies() -> usize {
+    static MAX: OnceLock<usize> = OnceLock::new();
+    *MAX.get_or_init(|| {
+        std::env::var("STALWART_MAX_LARGE_UPLOADS")
+            .ok()
+            .and_then(|v| v.trim().parse().ok())
+            .unwrap_or(usize::MAX)
+    })
+}
+
+/// One large body's slot. It rides in the request's extensions, so it is released when the request is
+/// dropped, after the handler is done with the body, not when the body has been read.
+struct LargeBody;
+
+impl Drop for LargeBody {
+    fn drop(&mut self) {
+        LARGE_IN_FLIGHT.fetch_sub(1, Ordering::SeqCst);
+    }
+}
+
+pub enum BodyRefusal {
