+/// Antivirus (common::file_scan), run after every cheaper check: refuse what is infected (422, so a
+/// client can tell it from a permission 403) or could not be scanned (503).
+async fn scanned(account_id: u32, bytes: &[u8]) -> crate::Result<()> {
+    common::file_scan::scan_file(account_id, bytes)
+        .await
+        .map_err(|refusal| {
+            DavError::Code(match refusal {
+                common::file_scan::FileRefusal::Infected => StatusCode::UNPROCESSABLE_ENTITY,
+                common::file_scan::FileRefusal::Unscanned => StatusCode::SERVICE_UNAVAILABLE,
+            })
+        })
+}
