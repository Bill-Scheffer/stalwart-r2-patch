+/// The checks every stored file gets (WebDAV applies the same in crates/dav/src/file/update.rs): the
+/// groupware file-size cap, which upstream JMAP did not apply, and antivirus (common::file_scan).
+pub(super) async fn file_write_refusal(
+    server: &Server,
+    account_id: u32,
+    contents: &[u8],
+) -> Option<SetError<FileNodeProperty>> {
+    let max = server.core.groupware.max_file_size;
+    if contents.len() > max {
+        return Some(SetError::too_large().with_description(format!(
+            "File is larger than the {max} byte limit."
+        )));
+    }
+    match common::file_scan::scan_file(account_id, contents).await {
+        Ok(()) => None,
+        Err(common::file_scan::FileRefusal::Infected) => {
+            Some(SetError::forbidden().with_description("The file contains malware."))
+        }
+        Err(common::file_scan::FileRefusal::Unscanned) => Some(SetError::forbidden().with_description(
+            "The file could not be scanned for malware; try again later.",
+        )),
+    }
+}
