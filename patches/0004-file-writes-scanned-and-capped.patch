+/// MainThrive patch 0004: the checks every stored file gets (WebDAV applies the same in crates/dav/src/file/update.rs):
+/// the groupware file-size cap, which upstream JMAP does not apply, and antivirus (common::file_scan).
+async fn file_write_refusal(
+    server: &Server,
+    account_id: u32,
+    contents: &[u8],
+) -> Option<SetError<FileNodeProperty>> {
+    let max = server.core.groupware.max_file_size;
+    if contents.len() > max {
+        // Readable as a client shows it ("25 MB"), since webmail displays this text as-is.
+        let limit = if max % (1024 * 1024) == 0 {
+            format!("{} MB", max / (1024 * 1024))
+        } else {
+            format!("{max} byte")
+        };
+        return Some(SetError::too_large().with_description(format!(
+            "The file is larger than the {limit} limit."
+        )));
+    }
+    match common::file_scan::scan_file(account_id, contents).await {
+        Ok(()) => None,
+        Err(common::file_scan::FileRefusal::Infected) => {
+            Some(SetError::forbidden().with_description("The file contains malware."))
+        }
+        Err(common::file_scan::FileRefusal::Unscanned) => Some(SetError::forbidden().with_description(
+            "The file could not be scanned for malware; try again later.",
+        )),
+    }
+}
+
 fn blob_not_found() -> SetError<FileNodeProperty> {
     SetError::invalid_properties()
         .with_property(FileNodeProperty::BlobId)
