+/// The checks every stored file gets (WebDAV applies the same in crates/dav/src/file/update.rs):
+/// the groupware file-size cap, which upstream JMAP did not apply, and antivirus.
+async fn file_write_refusal(
+    server: &Server,
+    contents: &[u8],
+) -> Option<SetError<FileNodeProperty>> {
+    let max = server.core.groupware.max_file_size;
+    if contents.len() > max {
+        return Some(SetError::too_large().with_description(format!(
+            "File is larger than the {max} byte limit."
+        )));
+    }
+    match common::file_scan::scan_file(contents).await {
+        common::file_scan::FileScan::Clean => None,
+        common::file_scan::FileScan::Infected(signature) => {
+            trc::event!(
+                Milter(trc::MilterEvent::ActionReject),
+                Details = "file scan: infected",
+                Reason = signature,
+            );
+            Some(SetError::forbidden().with_description("The file contains malware."))
+        }
+        common::file_scan::FileScan::Failed(reason) => {
+            trc::event!(
+                Milter(trc::MilterEvent::ActionConnectionFailure),
+                Details = "file scan: not scanned",
+                Reason = reason,
+            );
+            Some(SetError::forbidden().with_description(
+                "The file could not be scanned for malware; try again later.",
+            ))
+        }
+    }
+}
