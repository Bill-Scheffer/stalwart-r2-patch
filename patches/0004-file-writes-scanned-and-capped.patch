+
+//! Antivirus for stored files. When `STALWART_FILE_SCAN_CLAMD` names a clamd (`host:port`), every file
+//! written through WebDAV or JMAP `FileNode/set`/`FileNode/copy` is streamed to it (`INSTREAM`) before
+//! it is stored, the way the milter scans mail. It fails closed: a file that could not be scanned is
+//! refused. Unset, nothing is scanned (upstream's behaviour). Refusals log as milter events.
+
+use std::{sync::OnceLock, time::Duration};
+use tokio::{
+    io::{AsyncReadExt, AsyncWriteExt},
+    net::TcpStream,
+};
+
+pub enum FileRefusal {
+    Infected,
+    Unscanned,
+}
+
+enum Verdict {
+    Clean,
+    Infected(String),
+    Failed(String),
+}
+
+const CHUNK: usize = 1024 * 1024;
+const TIMEOUT: Duration = Duration::from_secs(60);
+
+fn clamd() -> Option<&'static str> {
+    static ADDR: OnceLock<Option<String>> = OnceLock::new();
+    ADDR.get_or_init(|| {
+        std::env::var("STALWART_FILE_SCAN_CLAMD")
+            .ok()
+            .filter(|addr| !addr.is_empty())
+    })
+    .as_deref()
+}
+
+pub async fn scan_file(account_id: u32, contents: &[u8]) -> Result<(), FileRefusal> {
+    let Some(addr) = clamd() else {
+        return Ok(());
+    };
+    let verdict = match tokio::time::timeout(TIMEOUT, instream(addr, contents)).await {
+        Ok(Ok(reply)) => verdict(&reply),
+        Ok(Err(err)) => Verdict::Failed(format!("clamd {addr}: {err}")),
+        Err(_) => Verdict::Failed(format!("clamd {addr}: timed out")),
+    };
+    match verdict {
+        Verdict::Clean => Ok(()),
+        Verdict::Infected(signature) => {
+            trc::event!(
+                Milter(trc::MilterEvent::ActionReject),
+                AccountId = account_id,
+                Details = "file scan: infected",
+                Reason = signature,
+            );
+            Err(FileRefusal::Infected)
+        }
+        Verdict::Failed(reason) => {
+            trc::event!(
+                Milter(trc::MilterEvent::ActionConnectionFailure),
+                AccountId = account_id,
+                Details = "file scan: not scanned",
+                Reason = reason,
+            );
+            Err(FileRefusal::Unscanned)
+        }
+    }
+}
+
+async fn instream(addr: &str, contents: &[u8]) -> std::io::Result<String> {
+    let mut stream = TcpStream::connect(addr).await?;
+    stream.write_all(b"zINSTREAM\0").await?;
+    for chunk in contents.chunks(CHUNK) {
+        stream.write_all(&(chunk.len() as u32).to_be_bytes()).await?;
+        stream.write_all(chunk).await?;
+    }
+    stream.write_all(&0u32.to_be_bytes()).await?;
+    let mut reply = Vec::new();
+    stream.read_to_end(&mut reply).await?;
+    Ok(String::from_utf8_lossy(&reply)
+        .trim_end_matches(['\0', '\n'])
+        .to_string())
+}
+
+/// clamd answers `stream: OK`, `stream: <signature> FOUND`, or `<message> ERROR`.
+fn verdict(reply: &str) -> Verdict {
+    match reply.strip_prefix("stream: ") {
+        Some("OK") => Verdict::Clean,
+        Some(found) if found.ends_with(" FOUND") => {
+            Verdict::Infected(found.trim_end_matches(" FOUND").to_string())
+        }
+        _ => Verdict::Failed(format!("clamd answered {reply:?}")),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{Verdict, verdict};
+
+    #[test]
+    fn reads_each_clamd_answer() {
+        assert!(matches!(verdict("stream: OK"), Verdict::Clean));
+        assert!(
+            matches!(verdict("stream: Eicar-Test-Signature FOUND"), Verdict::Infected(name) if name == "Eicar-Test-Signature")
+        );
+        assert!(matches!(
+            verdict("INSTREAM size limit exceeded. ERROR"),
+            Verdict::Failed(_)
+        ));
+        assert!(matches!(verdict(""), Verdict::Failed(_)));
+    }
+}
