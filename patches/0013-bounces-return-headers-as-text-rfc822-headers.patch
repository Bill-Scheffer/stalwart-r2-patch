+// MainThrive patch 0013: the DSN returns the original's headers only, which is RFC 6522's text/rfc822-headers, as
+// upstream already sends them for a DKIM2 message. Sent as message/rfc822, a relay that parses the part as a message
+// (Amazon SES) refuses the bounce: a header-only message whose Content-Type names a multipart has no boundary, and
+// quoted-printable breaks the headers it encodes. So 7bit, or 8bit for UTF-8 headers. Neither may carry a lone CR or
+// LF, which mail-builder would pass through as 7bit, so every line ends in CRLF; a line past SMTP's 998 octets is left
+// to mail-builder to encode. Patch 0014: a header byte that is not UTF-8 (legacy or spam mail) used to empty the whole
+// part; it is replaced instead, and everything else returned (MAI-1131).
+fn returned_headers(headers: Vec<u8>) -> MimePart<'static> {
+    let headers = String::from_utf8(headers)
+        .unwrap_or_else(|err| String::from_utf8_lossy(err.as_bytes()).into_owned())
+        .replace("\r\n", "\n")
+        .replace(['\r', '\n'], "\r\n")
+        .replace('\0', "");
+    if headers.split("\r\n").any(|line| line.len() > 998) {
+        MimePart::new(
+            ContentType::new("text/rfc822-headers"),
+            BodyPart::Text(headers.into()),
+        )
+    } else {
+        rfc822_headers_part(Cow::Owned(headers.into_bytes()))
+    }
+}
