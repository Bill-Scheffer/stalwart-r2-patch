+    /// True the first time an account's two-step code for `step` is accepted, false every time after.
+    /// The mark lives in the in-memory store, which every node shares, and is set atomically (Valkey
+    /// `SET NX`), so two nodes cannot both accept the same code.
+    pub async fn accept_totp_step_once(
+        &self,
+        account_id: u32,
+        step: u64,
+        valid_for: u64,
+    ) -> trc::Result<bool> {
+        let mut key = Vec::with_capacity(12);
+        key.extend_from_slice(&account_id.to_be_bytes());
+        key.extend_from_slice(&step.to_be_bytes());
+        self.in_memory_store()
+            .try_lock(crate::KV_TOTP_STEP_USED, &key, valid_for)
+            .await
+            .caused_by(trc::location!())
+    }
