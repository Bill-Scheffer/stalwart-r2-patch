@@ -0,0 +1,92 @@
+/*
+ * SPDX-FileCopyrightText: 2020 Stalwart Labs LLC <hello@stalw.art>
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-SEL
+ */
+
+//! Server-wide caps on how many large bodies are held in memory at once. Each account is bounded already
+//! (requests at once, a pending-upload quota), and SMTP per sender IP, but nothing bounds the sum: a burst
+//! across accounts or senders takes the process past its memory limit and it is OOM-killed, with every
+//! session on it. A body past the cap is refused retryably instead. Unset, a cap is no bound (upstream's
+//! behaviour).
+
+use std::{
+    fmt,
+    sync::{
+        OnceLock,
+        atomic::{AtomicUsize, Ordering},
+    },
+};
+
+/// An HTTP request body past this size counts against `STALWART_MAX_LARGE_UPLOADS`.
+pub const LARGE_UPLOAD: usize = 1024 * 1024;
+
+/// A message past this size counts against `STALWART_MAX_LARGE_MESSAGES`. Higher than an upload's, so
+/// ordinary mail is never counted: a message costs about 6 times its size in SMTP and 3 times in IMAP, so
+/// one under it costs at most about 30 MiB.
+pub const LARGE_MESSAGE: usize = 5 * 1024 * 1024;
+
+/// WebDAV PUT, JMAP upload and JMAP request bodies.
+pub static LARGE_UPLOADS: InFlight = InFlight::new("STALWART_MAX_LARGE_UPLOADS");
+
+/// Messages arriving by SMTP DATA or BDAT, or by IMAP APPEND.
+pub static LARGE_MESSAGES: InFlight = InFlight::new("STALWART_MAX_LARGE_MESSAGES");
+
+pub struct InFlight {
+    var: &'static str,
+    count: AtomicUsize,
+    max: OnceLock<usize>,
+}
+
+impl InFlight {
+    const fn new(var: &'static str) -> Self {
+        Self {
+            var,
+            count: AtomicUsize::new(0),
+            max: OnceLock::new(),
+        }
+    }
+
+    pub fn max(&self) -> usize {
+        *self.max.get_or_init(|| {
+            std::env::var(self.var)
+                .ok()
+                .and_then(|v| v.trim().parse().ok())
+                .unwrap_or(usize::MAX)
+        })
+    }
+
+    /// A slot, or `None` when the server holds as many as it may.
+    pub fn try_acquire(&'static self) -> Option<Slot> {
+        self.count
+            .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |n| {
+                (n < self.max()).then_some(n + 1)
+            })
+            .ok()
+            .map(|_| Slot(self))
+    }
+}
+
+/// One large body's place under its cap, given back when dropped.
+pub struct Slot(&'static InFlight);
+
+impl Drop for Slot {
+    fn drop(&mut self) {
+        self.0.count.fetch_sub(1, Ordering::SeqCst);
+    }
+}
+
+impl fmt::Debug for Slot {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(self.0.var)
+    }
+}
+
+// So a request that carries one can still be compared: two requests are equal whatever slots they hold.
+impl PartialEq for Slot {
+    fn eq(&self, _: &Self) -> bool {
+        true
+    }
+}
+
+impl Eq for Slot {}
