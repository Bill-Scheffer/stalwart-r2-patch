diff --git a/crates/utils/src/in_flight.rs b/crates/utils/src/in_flight.rs
new file mode 100644
index 0000000..a122932
--- /dev/null
+++ b/crates/utils/src/in_flight.rs
@@ -0,0 +1,107 @@
+/*
+ * SPDX-FileCopyrightText: 2020 Stalwart Labs LLC <hello@stalw.art>
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-SEL
+ */
+
+//! Server-wide budgets for the large bodies held in memory at once, in bytes. Each account is bounded already
+//! (requests at once, a pending-upload quota), and SMTP each sender IP, but nothing bounds the sum: a burst
+//! across accounts or senders takes the process past its memory limit and it is OOM-killed, with every
+//! session on it. A body that would take its budget past the limit is refused retryably instead. Counted in
+//! bytes, not bodies, so the bound holds whatever the size limits allow. Unset, a budget is no bound
+//! (upstream's behaviour). Not `common::network::limiter`: `imap-proto` cannot depend on `common`, and that
+//! limiter's load-then-add can let two callers past the limit.
+
+use std::sync::{
+    OnceLock,
+    atomic::{AtomicUsize, Ordering},
+};
+
+/// An HTTP request body past this size counts against `STALWART_MAX_LARGE_UPLOAD_MIB`.
+pub const LARGE_UPLOAD: usize = 1024 * 1024;
+
+/// A message past this size counts against `STALWART_MAX_LARGE_MESSAGE_MIB`. Higher than an upload's, so
+/// ordinary mail is never counted: a message costs about 6 times its size in SMTP and 3 times in IMAP, so
+/// one under it costs at most about 30 MiB.
+pub const LARGE_MESSAGE: usize = 5 * 1024 * 1024;
+
+/// WebDAV PUT, JMAP upload and JMAP request bodies.
+pub static LARGE_UPLOADS: Budget = Budget::new("STALWART_MAX_LARGE_UPLOAD_MIB");
+
+/// Messages arriving by SMTP DATA or BDAT, or by IMAP APPEND.
+pub static LARGE_MESSAGES: Budget = Budget::new("STALWART_MAX_LARGE_MESSAGE_MIB");
+
+pub struct Budget {
+    var: &'static str,
+    used: AtomicUsize,
+    max: OnceLock<usize>,
+}
+
+impl Budget {
+    const fn new(var: &'static str) -> Self {
+        Self {
+            var,
+            used: AtomicUsize::new(0),
+            max: OnceLock::new(),
+        }
+    }
+
+    /// The budget in bytes, from its variable in MiB.
+    pub fn max(&self) -> usize {
+        *self.max.get_or_init(|| {
+            std::env::var(self.var)
+                .ok()
+                .and_then(|v| v.trim().parse::<usize>().ok())
+                .map_or(usize::MAX, |mib| mib.saturating_mul(1024 * 1024))
+        })
+    }
+
+    fn take(&self, bytes: usize) -> bool {
+        let max = self.max();
+        self.used
+            .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |used| {
+                used.checked_add(bytes).filter(|&total| total <= max)
+            })
+            .is_ok()
+    }
+
+    /// A slot holding `bytes` of the budget, or `None` when they would take it past its limit.
+    pub fn try_acquire(&'static self, bytes: usize) -> Option<Slot> {
+        self.take(bytes).then_some(Slot {
+            budget: self,
+            bytes,
+        })
+    }
+}
+
+/// A large body's share of its budget, given back when dropped.
+pub struct Slot {
+    budget: &'static Budget,
+    bytes: usize,
+}
+
+impl Slot {
+    pub fn bytes(&self) -> usize {
+        self.bytes
+    }
+
+    /// Grows the share to `total` bytes, as the body grows; `false` when that would take the budget past its
+    /// limit, and the share is left as it was.
+    pub fn grow_to(&mut self, total: usize) -> bool {
+        if total <= self.bytes {
+            return true;
+        }
+        if self.budget.take(total - self.bytes) {
+            self.bytes = total;
+            true
+        } else {
+            false
+        }
+    }
+}
+
+impl Drop for Slot {
+    fn drop(&mut self) {
+        self.budget.used.fetch_sub(self.bytes, Ordering::SeqCst);
+    }
+}
