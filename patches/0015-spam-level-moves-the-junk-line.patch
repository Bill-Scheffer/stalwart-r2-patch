+/// The lookup namespace the API writes one row into per account whose spam level is not Normal:
+/// the key is the account's id, the value its Junk line, 1 to 99. Normal (50) writes no row.
+const SPAM_LEVEL_NAMESPACE: &str = "spam-level";
+
+/// The account's Junk line, or None for Normal. Never an error: one returned from delivery
+/// becomes a temporary failure and defers the mail, so a lookup that fails or a value that is
+/// not a line reads as no row, and is logged.
+async fn spam_level(
+    server: &Server,
+    account_id: u32,
+    address: &str,
+    session_id: u64,
+) -> Option<u8> {
+    // No store under the namespace is no row: it exists only once a row has been written.
+    let store = server.get_lookup_store(SPAM_LEVEL_NAMESPACE)?;
+    let value = match store
+        .key_get::<VariableWrapper>(Id::from(account_id).to_string())
+        .await
+    {
+        Ok(value) => value?.into_inner().to_string().into_owned(),
+        Err(err) => {
+            trc::error!(
+                err.details("Spam level lookup failed, delivering at Normal.")
+                    .ctx(trc::Key::To, address.to_string())
+                    .span_id(session_id)
+                    .caused_by(trc::location!())
+            );
+            return None;
+        }
+    };
+    let level = value.trim().parse::<u8>().ok().filter(|l| (1..100).contains(l));
+    if level.is_none() {
+        trc::event!(
+            Store(trc::StoreEvent::DataCorruption),
+            Details = "Spam level is not a number from 1 to 99, delivering at Normal.",
+            Value = value,
+            To = address.to_string(),
+            SpanId = session_id,
+            CausedBy = trc::location!()
+        );
+    }
+    level
+}
+
+/// Rescales a spam percentage so that `level` maps to 50, the line every reader of it uses:
+/// below the level onto 0-49, from it onto 50-100. 0 and 100 are kept, so a definite ham or
+/// spam stays one.
+fn rescale_spam_percentage(percentage: u8, level: u8) -> u8 {
+    let (p, l) = (u32::from(percentage.min(100)), u32::from(level.clamp(1, 99)));
+    (if p < l {
+        p * 50 / l
+    } else {
+        50 + (p - l) * 50 / (100 - l)
+    }) as u8
+}
